{
  "rules": {
    "users": {
      "$uid": {
        "profile": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": false
        }
      }
    },
    "decks": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "publicDecks": {
      ".read": false,
      ".write": false,
      ".indexOn": ["updatedAt"]
    }
  }
}
